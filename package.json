{
  "name": "xiaozhi-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "check:content": "node scripts/check-content.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:firmware": "node scripts/check-firmware-downloads.mjs",
    "check:reader": "node scripts/check-reader-experience.mjs",
    "images:audit": "node scripts/check-images.mjs --audit",
    "images:optimize": "node scripts/optimize-images.mjs",
    "check:images": "node scripts/check-images.mjs",
    "translations:status": "node scripts/translation-status.mjs",
    "check": "npm run check:content && npm run check:links && npm run check:language && npm run check:assets && npm run check:firmware && npm run check:reader && npm run check:images && npm run build",
    "check:language": "node --test scripts/tests/language-preference.test.mjs",
    "check:links": "node scripts/check-article-links.mjs"
  },
  "devDependencies": {
    "gray-matter": "4.0.3",
    "sharp": "0.35.5",
    "vitepress": "1.6.4",
    "vue": "3.5.45"
  },
  "overrides": {
    "vite": "6.4.6"
  }
}
